# 服务端默认 DeepSeek API Key（可选；页面里填写的 Key 优先）
DEEPSEEK_API_KEY=

# JWT 签名密钥（部署到公网时务必改成随机长字符串）
JWT_SECRET=dev-secret-change-me

# Redis（本机运行默认 127.0.0.1；docker compose 会自动改成 redis）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 公网免费服务防滥用：单用户每天的消息额度
DAILY_MESSAGE_LIMIT=200

# docker compose 对外端口
HOST_PORT=8010

# 可选：配了域名再用 docker-compose.tls.yml 自动申请 HTTPS
DOMAIN=
